put {
  url: {{baseUrl}}/api/v1/declarations/update
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-User-Name: {{user}}
}

body:json {
  {
    "year": {{year}},
    "month": {{month}},
    "cityCode": {{cityCode}}
  }
}

docs {
