            "value": "1",
            "enabled": false
          },
          {
            "name": "X-Requester-Id-No",
            "value": "12345678901",
            "enabled": false
          }
        ],
        "params": [],
        "body": {
          "mode": "json",
          "json": "{\n  \"ysvDosyaNoList\": [\n    \"PENTEST260801\",\n    \"PENTEST260802\"\n  ]\n}"
        },
        "auth": {
          "mode": "none"
        },
        "script": {
          "req": "",
          "res": ""
        },
        "vars": {
          "req": [],
          "res": []
        },
        "assertions": [],
        "tests": "",
        "docs": "DB'deki degerleri SBM'ye PUT eder. Excel upsert'unden donen updatedFileNos'u buraya verin. Donemin tamamini gondermek icin govdeyi {\"year\":2026,\"month\":8} yapin.\n\nKimlik: X-Requester-Id-Type / X-Requester-Id-No başlıkları kapalı gelir; kapalıyken token servisi şirket VKN'sini döner (toplu işlem). İşlemi yapanın kimliğiyle göndermek için ikisini de açıp gerçek değer yazın (tip 1/2/4; TCKN/YKN 11, VKN 10 hane)."
      }
